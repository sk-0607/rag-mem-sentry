# LLM provider = any OpenAI-compatible endpoint. Default is Google AI Studio (Gemini).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-3.1-flash-lite
# The gate (judge and S3) was calibrated and frozen on this model (eval/frozen_gate.json);
# without it the judge follows LLM_MODEL above.
JUDGE_MODEL=gemini-flash-lite-latest
# To use a different provider, also set LLM_BASE_URL and the key env in app/config.py, e.g.:
# LLM_BASE_URL=https://api.groq.com/openai/v1
